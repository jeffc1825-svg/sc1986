# ===== 公開(會進瀏覽器 bundle)=====
# 正式網域,用於 SEO canonical / sitemap / OG
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase 專案 URL 與 anon key(Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== 僅伺服器(絕不放 NEXT_PUBLIC_)=====
# Supabase service_role key:Storage 上傳、通知狀態回寫
SUPABASE_SERVICE_ROLE_KEY=

# 詢價通知信(Resend)。開發環境可留空 → 通知記為 skipped
RESEND_API_KEY=
# 業務收件信箱
QUOTE_NOTIFICATION_EMAIL=sales@example.com
# 已驗證網域的寄件位址
QUOTE_NOTIFICATION_FROM=SC1986 <noreply@example.com>
