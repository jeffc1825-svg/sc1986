# ===== 公開(會進瀏覽器 bundle)=====
# 正式網域,用於 SEO canonical / sitemap / OG
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase 專案 URL 與 anon key(Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key(公開)。開發環境可留空 → 不顯示驗證 widget
# Cloudflare Dashboard → Turnstile → Add widget(Managed 模式,網域填正式網域與 *.vercel.app)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ===== 僅伺服器(絕不放 NEXT_PUBLIC_)=====
# Supabase service_role key:Storage 上傳、通知狀態回寫
SUPABASE_SERVICE_ROLE_KEY=

# 建庫工具用(pnpm db:apply):資料庫連線字串
# Supabase Dashboard → Connect → Session pooler(IPv4 相容):
# postgresql://postgres.<project-ref>:<DB密碼>@aws-x-<region>.pooler.supabase.com:5432/postgres
# 註:anon / service key 無法執行 DDL,建表必須用此連線字串;僅本機使用,勿部署到 Vercel
SUPABASE_DB_URL=

# Cloudflare Turnstile secret key。開發環境可留空 → 略過驗證;正式環境必填(fail-closed)
TURNSTILE_SECRET_KEY=

# 詢價 Email 通知(Resend)。開發環境可留空 → 通知記為 skipped
RESEND_API_KEY=
# 業務收件信箱
QUOTE_NOTIFICATION_EMAIL=sales@example.com
# 已驗證網域的寄件位址
QUOTE_NOTIFICATION_FROM=SC1986 <noreply@example.com>
